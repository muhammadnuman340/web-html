# Target website. Use a site you own or are authorised to audit.
SITE_URL=http://localhost:4321
AUDIT_ALLOW_PRIVATE_NETWORK=true

# Discovery: auto | sitemap | crawl | routes
AUDIT_DISCOVERY=auto
AUDIT_ROUTES_FILE=./examples/audit-routes.example.txt

# Crawl and resource safeguards. AUDIT_MAX_PAGES=0 means no page-count cap.
AUDIT_MAX_PAGES=0
AUDIT_CRAWL_DEPTH=8
AUDIT_MAX_SITEMAPS=1000
AUDIT_MAX_SITEMAP_BYTES=20971520
AUDIT_CONCURRENCY=2
AUDIT_REQUEST_DELAY_MS=150
AUDIT_RESPECT_ROBOTS=true
AUDIT_TIMEOUT_MS=20000
AUDIT_RETRIES=1
AUDIT_SETTLE_MS=350
AUDIT_MAX_DURATION_MINUTES=120
AUDIT_MAX_HEAP_MB=1536

# URL variants and rules
AUDIT_KEEP_QUERY=false
AUDIT_INCLUDE_PATHS=
AUDIT_EXCLUDE_PATHS=/logout,/admin/**

# Audit profile
AUDIT_PROFILE=professional
# For AUDIT_PROFILE=custom only, e.g. seo,accessibility,mobile,fonts
AUDIT_PROFILE_CATEGORIES=seo,accessibility,mobile,fonts

# Reports and checks
AUDIT_OUTPUT_DIR=audit-reports
AUDIT_BRAND=NumanX / Omega Site Audit Pro
AUDIT_CHECK_EXTERNAL_LINKS=false
AUDIT_MAX_EXTERNAL_LINKS=300
AUDIT_LIGHTHOUSE=false
AUDIT_LIGHTHOUSE_MAX_PAGES=3

# Optional: Chromium location / container-only no-sandbox switch.
# AUDIT_CHROME_PATH=C:\path\to\chrome.exe
# AUDIT_CHROME_NO_SANDBOX=false

# Optional: local path to a JSON object of headers for an authorised staging site.
# Never commit the file or its contents.
# AUDIT_AUTH_HEADERS_FILE=C:\private\audit-headers.json

# Optional: Google Search Console Search Analytics query with an authorised, short-lived OAuth access token.
# Do not commit real tokens.
# GSC_SITE_URL=https://your-domain.example/
# GSC_ACCESS_TOKEN=replace-me
# GSC_START_DATE=2026-10-01
# GSC_END_DATE=2026-10-14

# Optional previous report JSON for inline comparison metadata.
# AUDIT_COMPARE_WITH=./audit-reports/previous-report.json
