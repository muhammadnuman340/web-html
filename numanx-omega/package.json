{
  "name": "numanx-omega",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "omega-audit": "./scripts/audit-site.mjs",
    "omega-history": "./scripts/manage-history.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs && node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "prod": "vite build && node scripts/prerender-seo.mjs && node scripts/generate-sitemap.mjs && node server.js",
    "audit": "node scripts/audit-site.mjs",
    "audit:site:pro": "node scripts/audit-site.mjs",
    "audit:site:v4": "node scripts/audit-site.mjs",
    "test": "node --test tests/core.test.mjs tests/report.test.mjs && node scripts/build-conversion-tests.mjs && node --test tests/conversion.test.mjs tests/routing.test.mjs tests/seo.test.mjs tests/pwa.test.mjs",
    "test:conversion": "node scripts/build-conversion-tests.mjs && node --test tests/conversion.test.mjs",
    "test:routing": "node scripts/build-conversion-tests.mjs && node --test tests/routing.test.mjs",
    "test:seo": "node scripts/build-conversion-tests.mjs && node --test tests/seo.test.mjs",
    "test:pwa": "node scripts/build-conversion-tests.mjs && node --test tests/pwa.test.mjs",
    "test:audit": "node --test tests/core.test.mjs tests/report.test.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "localforage": "^1.10.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "puppeteer": "^25.14.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
