/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), display-capture=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https://open.er-api.com https://api.coingecko.com https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self';
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Robots-Tag: index, follow

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Robots-Tag: index, follow

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
